# Port on which the internal engine API listens. Bind this to 127.0.0.1 / an
# internal Docker network only — never expose it to the public internet.
ENGINE_PORT=3001

# Shared secret Laravel must send as the "X-Internal-Secret" header on every
# request. Defense in depth: the engine should never be reachable from the
# public internet in the first place, but this stops a misconfigured
# firewall/reverse-proxy from turning into an open send-message relay.
ENGINE_INTERNAL_SECRET=change-me-to-a-long-random-value

# Where whatsapp-web.js persists the linked-session credentials (LocalAuth).
# Keep this on a persistent volume so the session survives restarts/deploys.
WWEBJS_DATA_PATH=./.wwebjs_auth

# Set to false to see the Chromium window (useful for local debugging only).
PUPPETEER_HEADLESS=true
