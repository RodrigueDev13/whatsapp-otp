# Used by docker-compose.yml when deploying with Docker.
# Generate APP_KEY with: docker compose run --rm app php artisan key:generate --show

APP_KEY=

# Public domain name for this deployment. Must have a DNS A record pointing
# to this host's public IP, with ports 80 and 443 reachable from the
# Internet (port-forwarded to this host if it's behind a router/NAT) — the
# `caddy` service uses this to obtain and renew a Let's Encrypt certificate
# automatically. APP_URL is derived from it (always https://).
DOMAIN=whatsapp-otp.example.com

ENGINE_INTERNAL_SECRET=change-me-to-a-long-random-value

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
