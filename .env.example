# Used by docker-compose.yml when deploying with Docker.
# Generate APP_KEY with: docker compose run --rm app php artisan key:generate --show

APP_KEY=

# Public domain for this deployment: a reserved/static domain from your
# ngrok account (free tier includes one), e.g. your-name.ngrok-free.dev —
# NOT a domain you own, and no DNS record or port-forwarding needed. The
# `ngrok` service tunnels outbound to it. APP_URL is derived from it
# (always https://).
DOMAIN=your-name.ngrok-free.dev

# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=change-me

ENGINE_INTERNAL_SECRET=change-me-to-a-long-random-value

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
